# Bee and all runtime data remain local to this project.
BEE_URL=http://127.0.0.1:1633
FOLIO_VERIFY_URL=https://api.gateway.ethswarm.org
# Set this in .env.local for funded light mode. A public RPC may be rate limited.
# BEE_BLOCKCHAIN_RPC_ENDPOINT=https://your-gnosis-rpc

# Run npm run hosting:setup to generate separate random keys locally.
# Set these server-only values on Vercel; never use NEXT_PUBLIC_.
# FOLIO_KEEPER_URL=https://your-keeper-tunnel.example
# FOLIO_BRIDGE_KEY=generated-by-hosting-setup
# FOLIO_OWNER_KEY=generated-by-hosting-setup
