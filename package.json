{
  "name": "folio-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "npm run build:reader && NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "bee:install": "node scripts/bee.mjs install",
    "bee:start": "node scripts/bee.mjs start",
    "bee:status": "node scripts/bee.mjs status",
    "recover": "tsx tools/recover.ts",
    "verify:archive": "tsx tools/recover.ts --verify-only",
    "reader": "node scripts/reader.mjs",
    "build:reader": "node scripts/build-reader.mjs",
    "bee:fund": "node scripts/fund-node.mjs",
    "format": "prettier --write src reader scripts tools tests",
    "hosting:setup": "node scripts/setup-hosting.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify:hosting": "node scripts/verify-hosting.mjs",
    "keeper:start": "node scripts/keeper-supervisor.mjs",
    "keeper:status": "node scripts/keeper-supervisor.mjs --status"
  },
  "dependencies": {
    "@ethersphere/bee-js": "13.1.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ethersphere/swarm-cli": "3.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@ethereumjs/wallet": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": "22.x"
  }
}
